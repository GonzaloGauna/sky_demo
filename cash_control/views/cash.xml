<odoo>
    <record id="view_pop_config_form" model="ir.ui.view"><field name="name">pop.config.form</field><field name="model">pop.config</field><field name="arch" type="xml"><form>
        <header><button name="open_session_cb" type="object" string="Nueva sesion" class="btn-primary"/><button name="open_existing_session_cb" type="object" string="Sesion actual" invisible="not current_session_id"/></header>
        <sheet><group><field name="name"/><field name="company_id"/><field name="active"/><field name="journal_ids" widget="many2many_tags"/><field name="cash_control"/><field name="sequence_id" groups="base.group_system"/><field name="current_session_id" readonly="1"/><field name="last_closed_session_id" readonly="1"/></group></sheet>
    </form></field></record>
    <record id="view_pop_config_tree" model="ir.ui.view"><field name="name">pop.config.list</field><field name="model">pop.config</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="current_session_state"/><field name="current_session_id"/></list></field></record>
    <record id="view_pop_session_form" model="ir.ui.view"><field name="name">pop.session.form</field><field name="model">pop.session</field><field name="arch" type="xml"><form>
        <header><button name="pop_cash_open" type="object" string="Contar apertura" invisible="state != 'opening_control'"/><button name="action_pop_session_open" type="object" string="Abrir" class="btn-primary" invisible="state != 'opening_control'"/><button name="pop_cash_in" type="object" string="Ingreso de efectivo" invisible="state != 'opened'"/><button name="pop_cash_out" type="object" string="Retiro de efectivo" invisible="state != 'opened'"/><button name="action_pop_session_closing_control" type="object" string="Iniciar cierre" invisible="state != 'opened'"/><button name="pop_cash_close" type="object" string="Contar cierre" invisible="state != 'closing_control'"/><button name="action_pop_session_validate" type="object" string="Cerrar" class="btn-primary" invisible="state != 'closing_control'"/><field name="state" widget="statusbar"/></header>
        <sheet><group><field name="name"/><field name="pop_id" readonly="state != 'opening_control'"/><field name="company_id"/><field name="user_id" readonly="state != 'opening_control'"/><field name="start_at"/><field name="stop_at"/><field name="currency_id" invisible="1"/></group>
        <field name="pop_session_journal_ids" readonly="state == 'closed'"><list editable="bottom" create="0" delete="0"><field name="journal_id" readonly="1"/><field name="currency_id" column_invisible="True"/><field name="balance_start" readonly="parent.state != 'opening_control'"/><field name="total_entry_encoding"/><field name="balance_end"/><field name="balance_end_real" readonly="parent.state != 'closing_control'"/><field name="difference"/></list></field>
        </sheet><chatter/>
    </form></field></record>
    <record id="view_pop_session_tree" model="ir.ui.view"><field name="name">pop.session.list</field><field name="model">pop.session</field><field name="arch" type="xml"><list><field name="name"/><field name="pop_id"/><field name="company_id"/><field name="user_id"/><field name="start_at"/><field name="stop_at"/><field name="state"/></list></field></record>
    <record id="view_pop_journal_form" model="ir.ui.view"><field name="name">pop.session.journal.form</field><field name="model">pop.session.journal</field><field name="arch" type="xml"><form><sheet><group><field name="pop_session_id"/><field name="journal_id"/><field name="currency_id" invisible="1"/><field name="balance_start"/><field name="balance_end_real"/><field name="balance_end"/><field name="difference"/></group><field name="line_ids" readonly="1"><list><field name="date"/><field name="name"/><field name="ref"/><field name="partner_id"/><field name="amount"/><field name="event"/><field name="anulado"/></list></field></sheet></form></field></record>
    <record id="account_payment_form_pop" model="ir.ui.view"><field name="name">account.payment.pop</field><field name="model">account.payment</field><field name="inherit_id" ref="account.view_account_payment_form"/><field name="arch" type="xml"><field name="journal_id" position="after"><field name="pop_id" groups="cash_control.group_pop_user" readonly="state != 'draft'"/><field name="pop_session_id" groups="cash_control.group_pop_user" readonly="state != 'draft'"/></field></field></record>
    <record id="users_form_pop" model="ir.ui.view"><field name="name">res.users.pop</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Waiki caja" groups="cash_control.group_pop_manager"><field name="default_pop_id"/></group></xpath></field></record>
    <record id="action_pop_config" model="ir.actions.act_window"><field name="name">Cajas Waiki</field><field name="res_model">pop.config</field><field name="view_mode">list,form</field></record>
    <record id="action_pop_session" model="ir.actions.act_window"><field name="name">Sesiones de caja</field><field name="res_model">pop.session</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_pop_root" name="Cajas Waiki" parent="account.menu_finance" groups="cash_control.group_pop_user" sequence="75"/>
    <menuitem id="menu_pop_config" name="Cajas" parent="menu_pop_root" action="action_pop_config"/>
    <menuitem id="menu_pop_sessions" name="Sesiones" parent="menu_pop_root" action="action_pop_session"/>
</odoo>
