<odoo>
    <record id="group_pop_user" model="res.groups"><field name="name">Waiki cash-session user</field><field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/></record>
    <record id="group_pop_manager" model="res.groups"><field name="name">Waiki cash-session manager</field><field name="implied_ids" eval="[(4, ref('cash_control.group_pop_user')), (4, ref('account.group_account_manager'))]"/></record>
    <record id="pop_config_company_rule" model="ir.rule"><field name="name">Cash points: selected companies</field><field name="model_id" ref="model_pop_config"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="pop_session_company_rule" model="ir.rule"><field name="name">Cash sessions: selected companies</field><field name="model_id" ref="model_pop_session"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="pop_journal_company_rule" model="ir.rule"><field name="name">Session journals: selected companies</field><field name="model_id" ref="model_pop_session_journal"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="pop_line_company_rule" model="ir.rule"><field name="name">Cash movements: selected companies</field><field name="model_id" ref="model_pop_session_journal_line"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
