<odoo>
    <record id="action_report_followup" model="ir.actions.report"><field name="name">Carta de cobranza Waiki</field><field name="model">res.partner</field><field name="report_type">qweb-pdf</field><field name="report_name">waiki_account_followup.report_followup_letter</field><field name="report_file">waiki_account_followup.report_followup_letter</field></record>
    <template id="report_followup_letter"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Estado de cuenta pendiente</h2><p t-field="o.display_name"/><p t-out="o.env.company.name"/><table class="table table-sm"><thead><tr><th>Comprobante</th><th>Vencimiento</th><th>Pendiente</th></tr></thead><tbody><tr t-foreach="o._waiki_overdue_lines()" t-as="line"><td><span t-field="line.move_id.name"/></td><td><span t-field="line.date_maturity"/></td><td><span t-field="line.amount_residual" t-options="{'widget':'monetary','display_currency':o.env.company.currency_id}"/></td></tr></tbody></table><p>Por favor revise los comprobantes detallados y contacte a su responsable de cuenta.</p></div></t></t></t></template>
</odoo>
