<odoo>
    <record id="followup_level_list" model="ir.ui.view"><field name="name">waiki.followup.level.list</field><field name="model">waiki.followup.level</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="delay"/><field name="repeat_days"/><field name="auto_execute"/><field name="send_email"/><field name="send_sms"/><field name="create_activity"/></list></field></record>
    <record id="followup_level_form" model="ir.ui.view"><field name="name">waiki.followup.level.form</field><field name="model">waiki.followup.level</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="active"/><field name="delay"/><field name="repeat_days"/><field name="auto_execute"/><field name="send_email"/><field name="mail_template_id" invisible="not send_email"/><field name="send_sms"/><field name="create_activity"/><field name="activity_user_id" invisible="not create_activity"/></group><field name="message"/></sheet></form></field></record>
    <record id="followup_history_list" model="ir.ui.view"><field name="name">waiki.followup.history.list</field><field name="model">waiki.followup.history</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="date"/><field name="partner_id"/><field name="company_id"/><field name="level_id"/><field name="user_id"/><field name="currency_id" column_invisible="True"/><field name="amount"/><field name="email_queued"/><field name="sms_requested"/><field name="activity_created"/></list></field></record>
    <record id="partner_followup_form" model="ir.ui.view"><field name="name">res.partner.waiki.followup</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page name="waiki_followup" string="Cobranzas Waiki" groups="account.group_account_invoice"><group><field name="waiki_followup_overdue"/><field name="waiki_followup_level_id"/><field name="waiki_followup_pause"/><field name="waiki_followup_next_date"/><field name="waiki_followup_responsible_id"/></group><button name="action_waiki_followup" type="object" string="Ejecutar seguimiento" class="btn-primary"/><button name="action_waiki_followup_letter" type="object" string="Imprimir carta"/></page></xpath></field></record>
    <record id="action_levels" model="ir.actions.act_window"><field name="name">Niveles de cobranza</field><field name="res_model">waiki.followup.level</field><field name="view_mode">list,form</field></record>
    <record id="action_history" model="ir.actions.act_window"><field name="name">Historial de cobranzas</field><field name="res_model">waiki.followup.history</field><field name="view_mode">list</field></record>
    <menuitem id="menu_followup_root" name="Cobranzas Waiki" parent="account.menu_finance" groups="account.group_account_invoice" sequence="76"/>
    <menuitem id="menu_levels" name="Niveles" parent="menu_followup_root" action="action_levels" groups="account.group_account_manager"/>
    <menuitem id="menu_history" name="Historial" parent="menu_followup_root" action="action_history"/>
</odoo>
