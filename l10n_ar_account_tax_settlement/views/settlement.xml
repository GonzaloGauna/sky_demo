<odoo>
    <record id="view_tax_form_inherited" model="ir.ui.view"><field name="name">account.tax.waiki.export</field><field name="model">account.tax</field><field name="inherit_id" ref="account.view_tax_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Waiki: datos de exportacion" groups="account.group_account_manager"><field name="codigo_regimen"/><field name="porcentaje_exclusion"/><field name="jurisdiction_code"/><field name="regimen_retencion"/><field name="regimen_percepcion"/><field name="api_articulo_inciso_calculo_retencion"/><field name="api_codigo_articulo_retencion"/><field name="api_articulo_inciso_calculo_percepcion"/><field name="api_codigo_articulo_percepcion"/></group></xpath></field></record>
    <record id="inflation_adjustment_index_tree" model="ir.ui.view"><field name="name">inflation.adjustment.index.list</field><field name="model">inflation.adjustment.index</field><field name="arch" type="xml"><list editable="top"><field name="date"/><field name="value"/><field name="xml_id" optional="hide"/></list></field></record>
    <record id="inflation_adjustment_form" model="ir.ui.view"><field name="name">inflation.adjustment.form</field><field name="model">inflation.adjustment</field><field name="arch" type="xml"><form><group><field name="company_id"/><field name="date_from"/><field name="date_to"/><field name="start_index"/><field name="end_index"/><field name="journal_id"/><field name="account_id"/><field name="open_cloure_entry"/><field name="closure_move_id" invisible="open_cloure_entry != 'yes'"/><field name="open_move_id" invisible="open_cloure_entry != 'yes'"/></group><footer><button name="confirm" type="object" string="Crear borrador de ajuste" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
    <record id="settlement_setup_form" model="ir.ui.view"><field name="name">waiki.tax.settlement.setup.form</field><field name="model">waiki.tax.settlement.setup</field><field name="arch" type="xml"><form><group><field name="company_id"/><field name="partner_id"/><field name="account_id"/></group><footer><button name="confirm" type="object" string="Configurar diarios" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
    <record id="inflation_adjustment_index_action" model="ir.actions.act_window"><field name="name">Indices de ajuste por inflacion</field><field name="res_model">inflation.adjustment.index</field><field name="view_mode">list,form</field></record>
    <record id="inflation_adjustment_action" model="ir.actions.act_window"><field name="name">Ajuste por inflacion</field><field name="res_model">inflation.adjustment</field><field name="view_mode">form</field><field name="target">new</field></record>
    <record id="settlement_setup_action" model="ir.actions.act_window"><field name="name">Configurar liquidaciones argentinas</field><field name="res_model">waiki.tax.settlement.setup</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="inflation_adjustment_index_menu" name="Indices de inflacion" parent="account.menu_finance" action="inflation_adjustment_index_action" groups="account.group_account_manager" sequence="78"/>
    <menuitem id="inflation_adjustment_menu" name="Ajuste por inflacion" parent="account.menu_finance" action="inflation_adjustment_action" groups="account.group_account_manager" sequence="79"/>
    <menuitem id="settlement_setup_menu" name="Configurar liquidaciones AR" parent="account.menu_finance" action="settlement_setup_action" groups="account.group_account_manager" sequence="80"/>
</odoo>
