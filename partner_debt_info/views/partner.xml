<odoo>
    <record id="view_partner_form_extend_cuentacorriente" model="ir.ui.view">
        <field name="name">res.partner.waiki.ledger</field><field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside">
            <button type="object" name="action_view_cuenta_corriente" class="oe_stat_button" icon="fa-book" groups="account.group_account_invoice">
                <field name="debt_balance" widget="statinfo" string="Cuenta corriente"/>
            </button>
        </xpath></field>
    </record>
    <record id="view_partner_tree" model="ir.ui.view">
        <field name="name">res.partner.waiki.debt.list</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml"><field name="display_name" position="after"><field name="debt_balance" optional="hide" groups="account.group_account_invoice"/><field name="ultima_fecha_comprobante" optional="hide" groups="account.group_account_invoice"/></field></field>
    </record>
    <record id="view_waiki_ledger_move_line_list" model="ir.ui.view">
        <field name="name">account.move.line.waiki.ledger</field><field name="model">account.move.line</field><field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml"><field name="balance" position="after"><field name="waiki_running_balance" optional="hide" groups="account.group_account_invoice"/></field></field>
    </record>
</odoo>
