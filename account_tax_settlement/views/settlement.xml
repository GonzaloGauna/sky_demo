    <record id="action_account_tax_settlement_wizard_form" model="ir.actions.act_window"><field name="name">Liquidar impuestos</field><field name="res_model">account.tax.settlement.wizard</field><field name="view_mode">form</field><field name="target">new</field><field name="binding_model_id" ref="account.model_account_move_line"/></record>
