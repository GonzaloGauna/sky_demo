    <record id="view_get_dates" model="ir.ui.view"><field name="name">get.dates.wizard.form</field><field name="model">get_dates_wizard</field><field name="arch" type="xml"><form><group><field name="from_date"/><field name="to_date"/></group><footer><button name="confirm" type="object" string="Continuar"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
    <record id="open_account_tax_settlement_kanban" model="ir.actions.act_window"><field name="name">Liquidaciones de impuestos</field><field name="res_model">account.journal</field><field name="view_mode">list,form</field><field name="view_id" ref="view_settlement_journal_list"/><field name="domain">[('tax_settlement','!=',False)]</field></record>
