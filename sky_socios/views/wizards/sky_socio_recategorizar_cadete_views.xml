<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sky_socio_recategorizar_cadete_form" model="ir.ui.view">
        <field name="name">sky.socio.recategorizar.cadete.form</field>
        <field name="model">sky.socio.recategorizar.cadete</field>
        <field name="arch" type="xml">
            <form string="Recategorizar por edad">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="current_category_id" readonly="1"/>
                        <field name="age" readonly="1"/>
                        <field name="message" readonly="1"/>
                        <field name="candidate_category_ids" widget="many2many_tags" readonly="1"/>
                        <field name="target_category_id" domain="[('id', 'in', candidate_category_ids)]"/>
                        <field name="observation"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
