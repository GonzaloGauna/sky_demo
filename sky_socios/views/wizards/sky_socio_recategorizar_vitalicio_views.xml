<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sky_socio_recategorizar_vitalicio_form" model="ir.ui.view">
        <field name="name">sky.socio.recategorizar.vitalicio.form</field>
        <field name="model">sky.socio.recategorizar.vitalicio</field>
        <field name="arch" type="xml">
            <form string="Pasar a Vitalicio">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="current_category_id" readonly="1"/>
                        <field name="suggested_category_id" readonly="1"/>
                        <field name="years_from_pase" readonly="1"/>
                        <field name="warning" readonly="1"/>
                        <field name="observation"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
