<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sky_socio_categoria_tree" model="ir.ui.view">
        <field name="name">sky.socio.categoria.tree</field>
        <field name="model">sky.socio.categoria</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="edad_minima"/>
                <field name="edad_maxima"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sky_socio_categoria_form" model="ir.ui.view">
        <field name="name">sky.socio.categoria.form</field>
        <field name="model">sky.socio.categoria</field>
        <field name="arch" type="xml">
            <form string="Categoría de socio">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color"/>
                            <field name="edad_minima"/>
                            <field name="edad_maxima"/>
                        </group>
                    </group>
                    <group>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sky_socio_categoria" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">sky.socio.categoria</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
