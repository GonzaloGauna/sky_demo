<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sky_familia_tree" model="ir.ui.view">
        <field name="name">sky.familia.tree</field>
        <field name="model">sky.familia</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Código"/>
                <field name="jefe_id"/>
                <field name="member_count"/>
            </list>
        </field>
    </record>

    <record id="view_sky_familia_kanban" model="ir.ui.view">
        <field name="name">sky.familia.kanban</field>
        <field name="model">sky.familia</field>
        <field name="arch" type="xml">
            <kanban class="o_sky_family_kanban">
                <field name="name"/>
                <field name="jefe_id"/>
                <field name="member_count"/>
                <field name="member_preview_html"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record o_sky_family_card">
                            <div class="o_sky_family_card_header">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="member_count"/> miembros</div>
                            </div>
                            <div class="o_sky_family_card_body">
                                <field name="member_preview_html" widget="html"/>
                            </div>
                            <div class="o_sky_family_card_footer">
                                <span class="text-muted">Jefe: <field name="jefe_id"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sky_familia_form" model="ir.ui.view">
        <field name="name">sky.familia.form</field>
        <field name="model">sky.familia</field>
        <field name="arch" type="xml">
            <form string="Familia">
                <header>
                    <button name="action_open_tree" type="object" class="oe_stat_button" icon="fa-sitemap" invisible="not id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Árbol familiar</span>
                        </div>
                    </button>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Código"/>
                            <field name="jefe_id"/>
                        </group>
                        <group>
                            <field name="member_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notas"/>
                    </group>
                    <notebook>
                        <page string="Miembros">
                            <field name="member_ids">
                                <list default_order="grupo_familiar_sequence, fecha_nacimiento, id">
                                    <field name="grupo_familiar_sequence" column_invisible="1"/>
                                    <field name="image_1920" widget="image" options="{'size': [32, 32]}"/>
                                    <field name="apellido"/>
                                    <field name="nombre"/>
                                    <field name="grupo_familiar"/>
                                    <field name="edad"/>
                                    <field name="categoria_socio_id"/>
                                    <field name="activa"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sky_familia" model="ir.actions.act_window">
        <field name="name">Familias</field>
        <field name="res_model">sky.familia</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
